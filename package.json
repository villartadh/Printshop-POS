  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src/test/unit",
    "test:ui": "vitest run src/test/ui",
    "test:api": "vitest run src/test/api",
    "test:e2e": "tsx scripts/e2e-smoke.ts",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run build",
    "test:full": "npm run verify && npm run test:e2e"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
