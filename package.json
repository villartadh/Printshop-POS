    "@vitejs/plugin-react": "^6.1.1",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.6.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.11.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  },
